# Copy to .env and change both passwords. .env is git-ignored (EC-OPS-004).
POSTGRES_OWNER_PASSWORD=change-me-owner
EDGE_APP_PASSWORD=change-me-app

# First user created by `bun run db:seed` (single personal book; no public sign-up in MVP).
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me-please

# Agent (optional). The app is complete and safe without it (US-12).
AGENT_PROVIDER=ollama
AGENT_MODEL=qwen3.5:9b-mlx
EMBED_MODEL=embeddinggemma
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Host ports (change if they clash with other local services). Containers always use 5432/8787/5173 inside.
EDGE_DB_PORT=5432
EDGE_API_PORT=8787
EDGE_WEB_PORT=5173
